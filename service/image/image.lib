source "${EMPEROR_SRC_DIR}/internal/logger/import.logger"
source "${EMPEROR_SRC_DIR}/lib/json/import._json"
source "${EMPEROR_SRC_DIR}/lib/uuid/import.uuid"
source "${EMPEROR_SRC_DIR}/lib/image/import.image"
source "${EMPEROR_SRC_DIR}/lib/utils/import.utils"

function service.image.init() {
	local uuid

	declare -Ag IMAGE
	IMAGE=(
		[UUID]=""
		[DISTRO]=""
		[RELEASE]=""
		[NAME]=""
		[CTIME]=""
		[CHECKSUM_FILE]=""
		[HASH]=""
		[IMAGE_DIR]=""
		[IMAGE_FILE]=""
	)

	IMAGE[UUID]="$(lib.uuid.generate)"
	if [ -z "${IMAGE[UUID]}" ]; then
		internal.logger.panic "${FUNCNAME[0]}: failed to generate UUID for new image"
	fi
	IMAGE[IMAGE_DIR]="${EMPEROR_IMAGESTORE_DIR}/${IMAGE[UUID]}"

	return 0
}

function service.image.build_prepare() {
	local image_dir

	image_dir=""
	# Check if a image with the same name already exists
	image_dir="$(_service.image.get_image_dir_by_name_or_id "${IMAGE[NAME]}")"
	if [ -n "$image_dir" ]; then
		internal.logger.error "an image with name '${IMAGE[NAME]}' already exists"
		return 1
	fi

	if ! _service.image.check_distro "${IMAGE[DISTRO]}" "${IMAGE[RELEASE]}"; then
		return 1
	fi

	if ! mkdir -p "${IMAGE[IMAGE_DIR]}"; then
		internal.logger.panic "${FUNCNAME[0]}: failed to create image directory for image '${IMAGE[UUID]}'"
	fi
	return 0
}

function service.image.build() {
	local img ctime checksum

	ctime="$(date +%Y-%m-%d_%H-%M-%S-%Z)"

	if ! img="$(lib.image.build_new "${IMAGE[NAME]}" "${IMAGE[DISTRO]}" "${IMAGE[RELEASE]}" \
		"${IMAGE[UUID]}" "${IMAGE[IMAGE_DIR]}")"; then
		_service.image.clean_image_resources
		return 1
	fi

	IMAGE[CTIME]="$ctime"
	IMAGE[IMAGE_FILE]="$img"
	IMAGE[CHECKSUM_FILE]="${IMAGE[IMAGE_DIR]}/${IMAGE[NAME]}.sha256"
	if ! checksum=$(lib.utils.make_checksum_sha256 "${IMAGE[IMAGE_FILE]}" "${IMAGE[CHECKSUM_FILE]}"); then
		internal.logger.error "failed to generate checksum for ${IMAGE[IMAGE_FILE]}"
		return 1
	fi
	IMAGE[HASH]="$checksum"

	return 0
}

function _service.image.clean_image_resources() {
	if [ -d "${IMAGE[IMAGE_DIR]}" ]; then
		rm -rf "${IMAGE[IMAGE_DIR]}"
	fi
	return 0
}

# TODO: Maybe this is not even needed ? lib.image handles the
# image creation and will just error out if the arguments are
# invalid, so we shouldnt be too smart about what the user
# wants.
function _service.image.check_distro() {
	local rc distro release
	rc=0
	distro="${IMAGE[DISTRO]}"
	release="${IMAGE[RELEASE]}"

	case "${distro}" in
	'debian') ;&
	'ubuntu') ;&
	'fedora') ;;
	*)
		internal.logger.error "unknown distro '$distro'"
		rc=1
		;;
	esac

	return $rc
}

# This function will extract the image and make it available for the realm
# returns the extracted images root directory
function service.image.prepare_image_fs() {
	local uuid dcomp_dir image_path
	local uid_map gid_map
	uuid="$1"
	uid="$2"
	uid_map="$3"
	gid_map="$4"
	gid="$uid"
	image_path="$(service.image.ref_to_key_val "$uuid" "path")"

	dcomp_dir="${EMPEROR_IMAGES_FS_DIR}/${uuid}/${EMPEROR_IMAGE_DEFAULT_ROOTFS_DIRNAME}"
	if [ ! -d "$dcomp_dir" ] && ! mkdir -p "$dcomp_dir"; then
		internal.logger.error "${FUNCNAME[0]}: failed to create image root dir"
		return 1
	fi

	if ! lib.image.idmapped_decompress_image "$image_path" "$dcomp_dir" "$uid" "$gid" "$uid_map" "$gid_map"; then
		internal.logger.error "${FUNCNAME[0]}: failed to decompress '$image_path' to '$dcomp_dir'"
		return 1
	fi

	echo "$dcomp_dir"
	return 0
}

function _service.image.get_image_dir_by_name_or_id() {
	local image_ref entry uuid rc
	image_ref="$1"

	# TODO: The function panics but might just kill the subshell only
	inv_path="$(_service.image.get_image_store_inventory_file)"

	if ! entry="$(_service.image.get_inventory_entry "$inv_path" "$image_ref")"; then
		return 1
	fi

	uuid="$(_service.image.get_key_val_from_image_entry "$entry" "uuid")"
	if [ -z "$uuid" ]; then
		return 1
	fi

	echo "${EMPEROR_IMAGESTORE_DIR}/${uuid}"
	return 0
}

function _service.image.get_inventory_entry() {
	local inv ref entry
	inv="$1"
	ref="$2"

	if ! entry=$(lib.json.get_object_from_val_in_key "$inv" "$ref" "name"); then
		if ! entry=$(lib.json.get_object_from_val_in_key "$inv" "$ref" "uuid"); then
			return 1
		fi
	fi

	echo "$entry"
	return 0
}

function _service.image.get_key_val_from_image_entry() {
	local entry key val
	entry="$1"
	key="$2"

	val="$(lib.json.get_key_value "$entry" "$key")"
	if [ -z "$val" ]; then
		return 1
	fi

	echo "$val"
	return 0
}

function service.image.ref_to_key_val() {
	local ref key val inv entry
	ref="$1"
	key="$2"

	inv="$(_service.image.get_image_store_inventory_file)"

	if ! entry="$(_service.image.get_inventory_entry "$inv" "$ref")"; then
		return 1
	fi

	val="$(lib.json.get_key_value "$entry" "$key")"
	echo "$val"
	return 0
}

# Image store
function _service.image.get_image_store_inventory_file() {
	if ! _service.image.check_image_store_dir; then
		return 1
	fi

	echo "${EMPEROR_IMAGESTORE_DIR}/${EMPEROR_IMAGESTORE_INVENTORY_FILENAME}"

	return 0
}

function _service.image.check_image_store_dir() {
	local store_dir inv_file
	store_dir="${EMPEROR_IMAGESTORE_DIR}"
	inv_file="${EMPEROR_IMAGESTORE_INVENTORY_FILENAME}"

	# The image store might not exist and needs to be initialized again
	if [[ ! -d "$store_dir" || ! -f "${store_dir}/${inv_file}" ]]; then
		_service.image.init_image_store
	fi
	return 0
}

function _service.image.init_image_store() {
	local rc=0 inv_file
	inv_file="${EMPEROR_IMAGESTORE_DIR}/${EMPEROR_IMAGESTORE_INVENTORY_FILENAME}"

	if [ ! -d "${EMPEROR_IMAGESTORE_DIR}" ]; then
		mkdir -p "${EMPEROR_IMAGESTORE_DIR}"
		rc=$?
	fi

	touch "$inv_file"
	rc=$?

	if ! lib.json.write_empty "$inv_file"; then
		rc=$?
		internal.logger.error "${FUNCNAME[0]}: failed to create store inventory state file"
	fi

	if [ $rc != 0 ]; then
		internal.logger.panic "${FUNCNAME[0]}: failed to init the image store"
	fi
	return $rc
}

# Setters
function service.image.set_creation_time() {
	IMAGE[CTIME]="$1"
	return 0
}

function service.image.set_distro() {
	IMAGE[DISTRO]="${1,,}"
	return 0
}

function service.image.set_release() {
	IMAGE[RELEASE]="$1"
	return 0
}

function service.image.set_name() {
	IMAGE[NAME]="$1"
	return 0
}

function service.image.set_hash() {
	IMAGE[HASH]="$1"
	return 0
}

function service.image.set_image_dir_path() {
	IMAGE[IMAGE_DIR]="$1"
	return 0
}

# Misc
function service.image.print_info() {
	for k in "${!IMAGE[@]}"; do
		echo "$k: ${IMAGE[$k]}"
	done
	return 0
}
