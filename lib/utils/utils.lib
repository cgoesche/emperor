function lib.utils.make_checksum_sha256() {
	local file sum_file
	file="$1"
	sum_out="$2"

	sha256sum "$file" >"$sum_out"
	awk -F' ' '{print $1}' "$sum_out"
	return $?
}

function lib.utils.verify_checksum_sha256() {
	local sum_file
	sum_file="$1"

	sha256sum --quiet --check "$sum_file"
	return $?
}

function lib.utils.get_boottime_secs() {
	awk -F '.' '{print $1}' /proc/uptime
}

function lib.utils.get_monotonic_secs() {
	python3 -c 'import time; print(int(time.clock_gettime(time.CLOCK_MONOTONIC)))'
}
