source "${EMPEROR_SRC_DIR}/service/import.service"

function _cmd.create.image.parser() {
	local -a args="( "$@" )"
	local opts shortopts longopts rc
	rc=0
	shortopts="+d:r:"
	longopts="distro:,release:"

	if (("${#args}" < 4)); then
		internal.logger.panic "too few arguments"
	fi

	opts="$(getopt -l "${longopts}" -o "${shortopts}" -n "${PROGRAM_INVOCATION_NAME}" -- "${args[@]}")"
	[ "$?" != 0 ] && {
		internal.logger.error "getopt(1) error"
		return 1
	}

	eval set -- "$opts"

	while true; do
		case "$1" in
		'-d' | '--distro')
			service.image.set_distro "$2"
			shift 2
			continue
			;;
		'--release')
			service.image.set_release "$2"
			shift 2
			continue
			;;
		'--')
			shift
			break
			;;
		*)
			echo "${FUNCNAME[0]}: invalid option" >&2
			rc=1
			break
			;;
		esac
	done

	# Accessing permutated arguments
	args=("$@")

	if ((${#args[@]} > 1)); then
		internal.logger.panic "too many arguments"
	elif ((${#args[@]} < 1)); then
		internal.logger.panic "missing image name"
	else
		service.image.set_name "${args[0]}"
	fi

	return "$rc"
}

function _cmd.create.network.parser() {
	return 0
}

function _cmd.create.realm.parser() {
	local -a args="( "$@" )"
	local opts shortopts longopts rc
	rc=0
	shortopts="+n:i:"
	longopts="network:,egress-iface:,hostname::,image:,subnet-range:,gateway:,ip:,image:,exil"

	opts="$(getopt -l "${longopts}" -o "${shortopts}" -n "${PROGRAM_INVOCATION_NAME}" -- "${args[@]}")"
	[ "$?" != 0 ] && {
		internal.logger.error "getopt(1) error"
		return 1
	}

	eval set -- "$opts"

	while true; do
		case "$1" in
		'-n' | '--network')
			service.realm.set_network "$2"
			shift 2
			continue
			;;
		'--egress-iface')
			service.realm.set_egress_iface "$2"
			shift 2
			continue
			;;
		'--hostname')
			service.realm.set_hostname "$2"
			shift 2
			continue
			;;
		'--subnet-range')
			service.realm.set_subnet_range "$2"
			shift 2
			continue
			;;
		'--gateway')
			service.realm.set_gateway "$2"
			shift 2
			continue
			;;
		'--ip')
			service.realm.set_ip "$2"
			shift 2
			continue
			;;
		'-i' | '--image')
			service.realm.set_image_ref "$2"
			shift 2
			continue
			;;
		'--exil')
			service.realm.set_exil_mode "$2"
			shift 2
			continue
			;;
		'--')
			shift
			break
			;;
		*)
			echo "${FUNCNAME[0]}: invalid option" >&2
			rc=1
			break
			;;
		esac
	done

	if [ -z "${REALM[IMAGE_REF]}" ]; then
		internal.logger.panic "no image reference specified (name or UUID)"
	fi

	# Accessing permutated arguments
	args=("$@")

	if ((${#args[@]} < 1)); then
		internal.logger.panic "missing container name"
	elif ((${#args[@]} > 1)); then
		service.realm.set_name "${args[0]}"
		shift 1
		service.realm.set_entrypoint_cmd "$*"
	else
		# TODO: Cant have the same name as another realm
		service.realm.set_name "${args[0]}"
	fi

	# Set image variables
	# TODO: This has to go in a dedicated file
	rc=0
	if ! image_name="$(service.image.ref_to_key_val "${REALM[IMAGE_REF]}" "name")"; then
		rc=$?
	fi
	service.realm.set_image_name "$image_name"

	if ! image_uuid="$(service.image.ref_to_key_val "${REALM[IMAGE_REF]}" "uuid")"; then
		rc=$?
	fi
	service.realm.set_image_uuid "$image_uuid"

	if ! image_path="$(service.image.ref_to_key_val "${REALM[IMAGE_REF]}" "path")"; then
		rc=$?
	fi
	service.realm.set_image_path "$image_path"

	return "$rc"
}

function _cmd.create.realm.handler() {
	local -a args=("$@")

	service.realm.init

	if ! _cmd.create.realm.parser "$@"; then
		# TODO: Thats sloppy bro
		internal.logger.error "failed to parse"
		return $?
	fi

	# Check if an image has been found
	if [ -z "${REALM[IMAGE_PATH]}" ]; then
		internal.logger.info "could not find image with reference '${REALM[IMAGE_REF]}'"
		# TODO: Add a usage() function for the subcommand
		# Maybe move the different handlers and parsers to their own
		# files too ? cmd/create/import.create -> root, realm, network, image
		# cmd/root then imports cmd/create/import.create
		internal.logger.error "Please build an image first, see 'emperor create image --help'"
		return 1
	fi

	service.realm.prepare
	service.realm.stage
	service.realm.invade

	return 0
}

function _cmd.create.image.handler() {
	local -a args=("$@")

	service.image.init

	if ! _cmd.create.image.parser "$@"; then
		return $?
	fi

	if ! service.image.build_prepare; then
		internal.logger.error "failed to prepare image build"
		return 1
	fi

	if ! service.image.build; then
		internal.logger.error "failed to build image"
		return 1
	fi

	if ! service.data.image_store_update_inventory; then
		return 1
	fi
	internal.logger.info "image store inventory updated successfully."

	echo "New image has been created:"
	service.image.print_info

	return 0
}

# Parses the command line for the create command
# @args: command line arguments argv[argc - 1]
function cmd.create.parser() {
	local subcmd
	local -a args=("$@")

	if [[ "${#args[@]}" == 0 || -z "${args[*]}" ]]; then
		internal.logger.panic "${FUNCNAME[0]}(): empty @args parameter"
	fi

	subcmd="${args[0]}"
	case "$subcmd" in
	'image')
		shift 1
		_cmd.create.image.handler "${@}"
		return $?
		;;
	'network')
		shift 1
		_cmd.create.network.parser "${@}"
		return $?
		;;
	'realm')
		shift 1
		_cmd.create.realm.handler "${@}"
		return $?
		;;
	*)
		internal.logger.panic "unknown 'create' subcommand '${subcmd}'"
		;;
	esac
}
